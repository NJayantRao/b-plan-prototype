# Public configuration only. Never put secrets in NEXT_PUBLIC_* variables.

# Base URL of the Express API (including the /api/v1 prefix).
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Shows one-click demo logins on /login. Always on in development; set to
# "true" to enable in a deployed demo that uses the seeded synthetic accounts.
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
