# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS + CSRF origin check)
CLIENT_URL=http://localhost:3000
LOG_LEVEL=info

# --- MongoDB (Atlas or local) ---
DATABASE_URL=

# --- Redis (OTP, login lockout, refresh-token sessions) ---
REDIS_URL=redis://localhost:6379
# Set to true for managed Redis that requires TLS (e.g. Upstash rediss://)
REDIS_TLS=false

# --- Auth ---
# Generate each with:  openssl rand -base64 48   (must be different, 32+ chars)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# lax (default) works when frontend and API share a site (e.g. both on localhost).
# Use "none" when they are on different sites (e.g. Vercel + separate API host);
# this forces Secure cookies, so it needs HTTPS.
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=

# --- Email (optional) ---
# Without RESEND_API_KEY, emails are SIMULATED in development (the OTP is printed
# to the server log) and sign-up returns 503 in production. Nothing is faked.
# RESEND_API_KEY=
# MAIL_FROM="Magadh Ventures <onboarding@resend.dev>"

# --- Demo seed (development only) ---
# SEED_PASSWORD=Demo@12345

# --- Added in later phases (not read yet) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=
